# Deployment environment. Provider credentials (LLM, web search, finance,
# Bluesky, TTS) are per-user settings and cannot be set here: configure them
# in the UI under Settings after logging in.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./data/app.db
TZ=Europe/Berlin
LOG_LEVEL=info
# Run integration checks on startup (logged + shown in the UI). Set
# STARTUP_ANNOUNCE=true to also send the result as a text message to the room.
STARTUP_CHECK=true
STARTUP_ANNOUNCE=false
# Set by the Docker image; only needed for local production-style runs:
# WEB_DIST=./web/dist
# Public URL of this deployment; delivered briefs append a
# "View this Brief on Neuretina" link to APP_URL/briefs/<id>?token=<token>.
# The token opens that one brief in a read-only view without a login.
APP_URL=https://briefs.example.com
# Optional explicit ffmpeg binary used to convert speech to Ogg/Opus
# (default: whatever is on PATH).
# FFMPEG_PATH=

# ── Decision model (Laya) ────────────────────────────────────────────────────
# Optional local Laya multilingual model for event tagging. Source runs only:
# the Docker image ships neither the model nor its ONNX runtime, so pull it
# with `bun run laya:pull` when running from source.
# LAYA_MODEL_DIR=./data/models/laya

# ── Access ───────────────────────────────────────────────────────────────────
# Protect the whole site (UI + every API call) with one password. The first
# successful entry logs the browser in; leave empty to run without auth. The
# password logs in as the admin account.
AUTH_GLOBAL_PASSWORD=
# Optional: signs login sessions. By default it derives from the global
# password, so changing the password logs everyone out. Set a stable secret to
# keep sessions across password changes (needed once OIDC lands).
# AUTH_SESSION_SECRET=
# How long one login lasts before the password is asked again (default 720h).
# AUTH_SESSION_TTL_HOURS=720
# Account that owns the main database; every other account gets its own
# database file under <DB_PATH dir>/users/.
# ADMIN_USERNAME=admin

# ── Research defaults ────────────────────────────────────────────────────────
# Cron for the seeded "morning-brief" job (only created on first start):
DEFAULT_BRIEF_CRON=0 7 * * *
# Search time window: hour | day | 3days | week | month | year.
DEFAULT_SEARCH_RECENCY=3days
DEFAULT_SEARCH_RESULTS=6
# Reputable-source allowlist for web search (max 20 entries). Root domains
# match their subdomains; ".gov" matches the whole TLD. Unset = curated default
# (Wikipedia, major outlets, quality tech/science press, .gov). "off" searches
# the whole web.
# DEFAULT_SEARCH_DOMAINS=wikipedia.org,reuters.com,apnews.com,bbc.com
# After the first draft, dispatch subagents (Wikipedia + web + social) to dig
# into implications and context, then trace claims back to primary sources.
DEFAULT_BRIEF_LANGUAGE=en
# Model used to pick event tags from the existing tag list; empty uses the main
# model.
# EVENTS_TAG_MODEL=
